<?xml version="1.0" encoding="utf-8"?>
<!-- =================================================================================== -->
<!-- Hiwonder TonyPi Humanoid Robot URDF Model                                           -->
<!-- Proportions: Height ~373mm, Torso Width ~186mm across shoulders                     -->
<!-- Arm Links: Upper arm ~80mm, Forearm ~80mm                                           -->
<!-- Head: neck_pan / neck_pitch are PWM servos 2 / 1 (pulse 1500 = centred)                     -->
<!-- Arms (bus servos): shoulder_pitch 8/16, shoulder_roll 7/15, elbow 6/14 (left/right)        -->
<!-- Legs (bus servos): hip_roll 5/13, hip_pitch 4/12, knee 3/11, ankle_pitch 2/10, ankle_roll 1/9 -->
<!-- Joint zero = factory stand pose. Servo->angle calibration lives in digital_twin/mapping.py   -->
<!-- =================================================================================== -->
<robot name="tonypi">

  <!-- ==================== MATERIALS ==================== -->
  <material name="body_white">
    <color rgba="0.92 0.92 0.94 1.0"/>
  </material>
  
  <material name="servo_black">
    <color rgba="0.18 0.18 0.22 1.0"/>
  </material>

  <material name="accent_blue">
    <color rgba="0.12 0.58 0.95 1.0"/>
  </material>

  <material name="metal_grey">
    <color rgba="0.55 0.57 0.60 1.0"/>
  </material>

  <material name="camera_lens">
    <color rgba="0.05 0.05 0.08 1.0"/>
  </material>

  <material name="accent_orange">
    <color rgba="0.95 0.45 0.10 1.0"/>
  </material>

  <!-- ==================== BASE LINK: TORSO ==================== -->
  <link name="torso">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.75"/>
      <inertia ixx="0.0015" ixy="0.0" ixz="0.0" iyy="0.0012" iyz="0.0" izz="0.0016"/>
    </inertial>
    <!-- Main Chest Housing -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.082 0.106 0.110"/>
      </geometry>
      <material name="body_white"/>
    </visual>
    <!-- Chest Decorative Panel / Controller Cover -->
    <visual>
      <origin xyz="0.042 0 0.010" rpy="0 0 0"/>
      <geometry>
        <box size="0.006 0.076 0.070"/>
      </geometry>
      <material name="servo_black"/>
    </visual>
    <!-- Hiwonder Blue Badge Accent -->
    <visual>
      <origin xyz="0.046 0 0.010" rpy="0 0 0"/>
      <geometry>
        <box size="0.002 0.040 0.020"/>
      </geometry>
      <material name="accent_blue"/>
    </visual>
    <!-- Left Shoulder Servo Mount Bracket -->
    <visual>
      <origin xyz="0 0.072 0.040" rpy="0 0 0"/>
      <geometry>
        <box size="0.042 0.042 0.046"/>
      </geometry>
      <material name="servo_black"/>
    </visual>
    <!-- Right Shoulder Servo Mount Bracket -->
    <visual>
      <origin xyz="0 -0.072 0.040" rpy="0 0 0"/>
      <geometry>
        <box size="0.042 0.042 0.046"/>
      </geometry>
      <material name="servo_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.082 0.186 0.110"/>
      </geometry>
    </collision>
  </link>

  <!-- ==================== HEAD & NECK ==================== -->
  <!-- Neck Pan Joint (Servo 2: Yaw) -->
  <joint name="neck_pan" type="revolute">
    <parent link="torso"/>
    <child link="neck_link"/>
    <origin xyz="0 0 0.060" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="2.0" velocity="4.0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <link name="neck_link">
    <inertial>
      <origin xyz="0 0 0.012" rpy="0 0 0"/>
      <mass value="0.04"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.012" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.014" length="0.024"/>
      </geometry>
      <material name="servo_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.012" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.014" length="0.024"/>
      </geometry>
    </collision>
  </link>

  <!-- Neck Pitch Joint (Servo 1: Pitch) -->
  <joint name="neck_pitch" type="revolute">
    <parent link="neck_link"/>
    <child link="head"/>
    <origin xyz="0 0 0.024" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.7854" upper="0.7854" effort="2.0" velocity="4.0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <link name="head">
    <inertial>
      <origin xyz="0.005 0 0.025" rpy="0 0 0"/>
      <mass value="0.10"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <!-- Head Helmet Shell -->
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.062 0.066 0.050"/>
      </geometry>
      <material name="body_white"/>
    </visual>
    <!-- Face Visor -->
    <visual>
      <origin xyz="0.032 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.004 0.054 0.032"/>
      </geometry>
      <material name="servo_black"/>
    </visual>
    <!-- Dual Camera Eyes / Lens -->
    <visual>
      <origin xyz="0.035 0.016 0.025" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.009" length="0.005"/>
      </geometry>
      <material name="accent_blue"/>
    </visual>
    <visual>
      <origin xyz="0.035 -0.016 0.025" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.009" length="0.005"/>
      </geometry>
      <material name="accent_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.062 0.066 0.050"/>
      </geometry>
    </collision>
  </link>

  <!-- ==================== LEFT ARM ==================== -->
  <!-- Left Shoulder Pitch Joint (Servo 8: Forward / Backward) -->
  <joint name="l_shoulder_pitch" type="revolute">
    <parent link="torso"/>
    <child link="l_shoulder_pitch_link"/>
    <origin xyz="0 0.093 0.040" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="3.0" velocity="5.0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <link name="l_shoulder_pitch_link">
    <inertial>
      <origin xyz="0 0.008 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.00003"/>
    </inertial>
    <!-- Servo 7 Output Horn & U-Bracket -->
    <visual>
      <origin xyz="0 0.008 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.032 0.024 0.034"/>
      </geometry>
      <material name="servo_black"/>
    </visual>
    <collision>
      <origin xyz="0 0.008 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.032 0.024 0.034"/>
      </geometry>
    </collision>
  </link>

  <!-- Left Shoulder Roll Joint (Servo 7: Abduction / Wingspan) -->
  <joint name="l_shoulder_roll" type="revolute">
    <parent link="l_shoulder_pitch_link"/>
    <child link="l_upper_arm"/>
    <origin xyz="0 0.016 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="3.0" velocity="5.0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <!-- Left Upper Arm Link (~80mm) -->
  <link name="l_upper_arm">
    <inertial>
      <origin xyz="0 0.004 -0.040" rpy="0 0 0"/>
      <mass value="0.09"/>
      <inertia ixx="0.00008" ixy="0" ixz="0" iyy="0.00008" iyz="0" izz="0.00003"/>
    </inertial>
    <!-- Upper Arm Bracket Body -->
    <visual>
      <origin xyz="0 0.004 -0.040" rpy="0 0 0"/>
      <geometry>
        <box size="0.028 0.032 0.076"/>
      </geometry>
      <material name="body_white"/>
    </visual>
    <!-- Servo 8 / 6 casing accent -->
    <visual>
      <origin xyz="0 0.004 -0.020" rpy="0 0 0"/>
      <geometry>
        <box size="0.032 0.026 0.032"/>
      </geometry>
      <material name="servo_black"/>
    </visual>
    <!-- Elbow Servo Horn Accent at bottom of upper arm -->
    <visual>
      <origin xyz="0 0.004 -0.075" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.012" length="0.028"/>
      </geometry>
      <material name="metal_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0.004 -0.040" rpy="0 0 0"/>
      <geometry>
        <box size="0.028 0.032 0.080"/>
      </geometry>
    </collision>
  </link>

  <!-- Left Elbow Joint (Servo 6: Flexion / Extension) -->
  <joint name="l_elbow" type="revolute">
    <parent link="l_upper_arm"/>
    <child link="l_forearm"/>
    <origin xyz="0 0 -0.080" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="3.0" velocity="5.0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <!-- Left Forearm / Hand Link (~80mm) -->
  <link name="l_forearm">
    <inertial>
      <origin xyz="0 0.004 -0.040" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.00007" ixy="0" ixz="0" iyy="0.00007" iyz="0" izz="0.00002"/>
    </inertial>
    <!-- Forearm Bracket Shell -->
    <visual>
      <origin xyz="0 0.004 -0.035" rpy="0 0 0"/>
      <geometry>
        <box size="0.024 0.028 0.065"/>
      </geometry>
      <material name="body_white"/>
    </visual>
    <!-- Forearm Black Structural Trim -->
    <visual>
      <origin xyz="0 0.004 -0.020" rpy="0 0 0"/>
      <geometry>
        <box size="0.026 0.024 0.030"/>
      </geometry>
      <material name="servo_black"/>
    </visual>
    <!-- Hand / Gripper End Effector (faces inward, the way the elbow bends) -->
    <visual>
      <origin xyz="0 0.004 -0.075" rpy="0 0 0"/>
      <geometry>
        <box size="0.030 0.016 0.015"/>
      </geometry>
      <material name="servo_black"/>
    </visual>
    <visual>
      <origin xyz="0 -0.004 -0.082" rpy="0 0 0"/>
      <geometry>
        <box size="0.022 0.004 0.012"/>
      </geometry>
      <material name="accent_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0.004 -0.040" rpy="0 0 0"/>
      <geometry>
        <box size="0.024 0.028 0.080"/>
      </geometry>
    </collision>
  </link>

  <!-- ==================== RIGHT ARM ==================== -->
  <!-- Right Shoulder Pitch Joint (Servo 16: Forward / Backward) -->
  <joint name="r_shoulder_pitch" type="revolute">
    <parent link="torso"/>
    <child link="r_shoulder_pitch_link"/>
    <origin xyz="0 -0.093 0.040" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="3.0" velocity="5.0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <link name="r_shoulder_pitch_link">
    <inertial>
      <origin xyz="0 -0.008 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.00003"/>
    </inertial>
    <!-- Servo 15 Output Horn & U-Bracket -->
    <visual>
      <origin xyz="0 -0.008 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.032 0.024 0.034"/>
      </geometry>
      <material name="servo_black"/>
    </visual>
    <collision>
      <origin xyz="0 -0.008 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.032 0.024 0.034"/>
      </geometry>
    </collision>
  </link>

  <!-- Right Shoulder Roll Joint (Servo 15: Abduction / Wingspan) -->
  <joint name="r_shoulder_roll" type="revolute">
    <parent link="r_shoulder_pitch_link"/>
    <child link="r_upper_arm"/>
    <origin xyz="0 -0.016 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="3.0" velocity="5.0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <!-- Right Upper Arm Link (~80mm) -->
  <link name="r_upper_arm">
    <inertial>
      <origin xyz="0 -0.004 -0.040" rpy="0 0 0"/>
      <mass value="0.09"/>
      <inertia ixx="0.00008" ixy="0" ixz="0" iyy="0.00008" iyz="0" izz="0.00003"/>
    </inertial>
    <!-- Upper Arm Bracket Body -->
    <visual>
      <origin xyz="0 -0.004 -0.040" rpy="0 0 0"/>
      <geometry>
        <box size="0.028 0.032 0.076"/>
      </geometry>
      <material name="body_white"/>
    </visual>
    <!-- Servo 16 / 14 casing accent -->
    <visual>
      <origin xyz="0 -0.004 -0.020" rpy="0 0 0"/>
      <geometry>
        <box size="0.032 0.026 0.032"/>
      </geometry>
      <material name="servo_black"/>
    </visual>
    <!-- Elbow Servo Horn Accent -->
    <visual>
      <origin xyz="0 -0.004 -0.075" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.012" length="0.028"/>
      </geometry>
      <material name="metal_grey"/>
    </visual>
    <collision>
      <origin xyz="0 -0.004 -0.040" rpy="0 0 0"/>
      <geometry>
        <box size="0.028 0.032 0.080"/>
      </geometry>
    </collision>
  </link>

  <!-- Right Elbow Joint (Servo 14: Flexion / Extension) -->
  <joint name="r_elbow" type="revolute">
    <parent link="r_upper_arm"/>
    <child link="r_forearm"/>
    <origin xyz="0 0 -0.080" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="3.0" velocity="5.0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <!-- Right Forearm / Hand Link (~80mm) -->
  <link name="r_forearm">
    <inertial>
      <origin xyz="0 -0.004 -0.040" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.00007" ixy="0" ixz="0" iyy="0.00007" iyz="0" izz="0.00002"/>
    </inertial>
    <!-- Forearm Bracket Shell -->
    <visual>
      <origin xyz="0 -0.004 -0.035" rpy="0 0 0"/>
      <geometry>
        <box size="0.024 0.028 0.065"/>
      </geometry>
      <material name="body_white"/>
    </visual>
    <!-- Forearm Black Structural Trim -->
    <visual>
      <origin xyz="0 -0.004 -0.020" rpy="0 0 0"/>
      <geometry>
        <box size="0.026 0.024 0.030"/>
      </geometry>
      <material name="servo_black"/>
    </visual>
    <!-- Hand / Gripper End Effector (faces inward, the way the elbow bends) -->
    <visual>
      <origin xyz="0 -0.004 -0.075" rpy="0 0 0"/>
      <geometry>
        <box size="0.030 0.016 0.015"/>
      </geometry>
      <material name="servo_black"/>
    </visual>
    <visual>
      <origin xyz="0 0.004 -0.082" rpy="0 0 0"/>
      <geometry>
        <box size="0.022 0.004 0.012"/>
      </geometry>
      <material name="accent_blue"/>
    </visual>
    <collision>
      <origin xyz="0 -0.004 -0.040" rpy="0 0 0"/>
      <geometry>
        <box size="0.024 0.028 0.080"/>
      </geometry>
    </collision>
  </link>

  <!-- ==================== PELVIS & LEGS (STANDING POSE) ==================== -->
  <joint name="waist_fixed" type="fixed">
    <parent link="torso"/>
    <child link="pelvis"/>
    <origin xyz="0 0 -0.055" rpy="0 0 0"/>
  </joint>

  <link name="pelvis">
    <inertial>
      <origin xyz="0 0 -0.015" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
    <!-- Pelvis Main Bracket -->
    <visual>
      <origin xyz="0 0 -0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.070 0.100 0.030"/>
      </geometry>
      <material name="servo_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.070 0.100 0.030"/>
      </geometry>
    </collision>
  </link>

  <!-- Left Leg -->
  <!-- L hip roll (servo 5: abduction) -->
  <joint name="l_hip_roll" type="revolute">
    <parent link="pelvis"/>
    <child link="l_hip_link"/>
    <origin xyz="0 0.045 -0.028" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.0" upper="1.0" effort="4.0" velocity="4.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>
  <link name="l_hip_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.04"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.034 0.034 0.034"/>
      </geometry>
      <material name="servo_black"/>
    </visual>
  </link>

  <joint name="l_hip_pitch" type="revolute">
    <parent link="l_hip_link"/>
    <child link="l_thigh"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.1" upper="2.1" effort="4.0" velocity="4.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <link name="l_thigh">
    <inertial>
      <origin xyz="0 0 -0.0375" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.00003"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.0375" rpy="0 0 0"/>
      <geometry>
        <box size="0.036 0.036 0.070"/>
      </geometry>
      <material name="body_white"/>
    </visual>
    <visual>
      <origin xyz="0 0 -0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.038 0.034 0.030"/>
      </geometry>
      <material name="servo_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.0375" rpy="0 0 0"/>
      <geometry>
        <box size="0.036 0.036 0.075"/>
      </geometry>
    </collision>
  </link>

  <joint name="l_knee" type="revolute">
    <parent link="l_thigh"/>
    <child link="l_shin"/>
    <origin xyz="0 0 -0.075" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.1" upper="2.1" effort="4.0" velocity="4.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <link name="l_shin">
    <inertial>
      <origin xyz="0 0 -0.0375" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.00003"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.0375" rpy="0 0 0"/>
      <geometry>
        <box size="0.034 0.034 0.070"/>
      </geometry>
      <material name="body_white"/>
    </visual>
    <visual>
      <origin xyz="0 0 -0.060" rpy="0 0 0"/>
      <geometry>
        <box size="0.038 0.034 0.028"/>
      </geometry>
      <material name="servo_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.0375" rpy="0 0 0"/>
      <geometry>
        <box size="0.034 0.034 0.075"/>
      </geometry>
    </collision>
  </link>

  <!-- L ankle pitch (servo 2) then ankle roll (servo 1) -->
  <joint name="l_ankle_pitch" type="revolute">
    <parent link="l_shin"/>
    <child link="l_ankle_link"/>
    <origin xyz="0 0 -0.075" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="4.0" velocity="4.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>
  <link name="l_ankle_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.04"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.034 0.034 0.034"/>
      </geometry>
      <material name="servo_black"/>
    </visual>
  </link>

  <joint name="l_ankle_roll" type="revolute">
    <parent link="l_ankle_link"/>
    <child link="l_foot"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.0" upper="1.0" effort="4.0" velocity="4.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>


  <link name="l_foot">
    <inertial>
      <origin xyz="0.015 0 -0.006" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
    <!-- Ankle Bracket -->
    <visual>
      <origin xyz="0 0 -0.003" rpy="0 0 0"/>
      <geometry>
        <box size="0.040 0.038 0.012"/>
      </geometry>
      <material name="servo_black"/>
    </visual>
    <!-- Broad Foot Sole Plate for High Stability -->
    <visual>
      <origin xyz="0.015 0 -0.010" rpy="0 0 0"/>
      <geometry>
        <box size="0.110 0.066 0.008"/>
      </geometry>
      <material name="metal_grey"/>
    </visual>
    <!-- Rubber Sole Pads -->
    <visual>
      <origin xyz="0.015 0 -0.014" rpy="0 0 0"/>
      <geometry>
        <box size="0.108 0.064 0.004"/>
      </geometry>
      <material name="servo_black"/>
    </visual>
    <collision>
      <origin xyz="0.015 0 -0.010" rpy="0 0 0"/>
      <geometry>
        <box size="0.110 0.066 0.012"/>
      </geometry>
    </collision>
  </link>

  <!-- Right Leg -->
  <!-- R hip roll (servo 13: abduction) -->
  <joint name="r_hip_roll" type="revolute">
    <parent link="pelvis"/>
    <child link="r_hip_link"/>
    <origin xyz="0 -0.045 -0.028" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.0" upper="1.0" effort="4.0" velocity="4.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>
  <link name="r_hip_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.04"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.034 0.034 0.034"/>
      </geometry>
      <material name="servo_black"/>
    </visual>
  </link>

  <joint name="r_hip_pitch" type="revolute">
    <parent link="r_hip_link"/>
    <child link="r_thigh"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.1" upper="2.1" effort="4.0" velocity="4.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <link name="r_thigh">
    <inertial>
      <origin xyz="0 0 -0.0375" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.00003"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.0375" rpy="0 0 0"/>
      <geometry>
        <box size="0.036 0.036 0.070"/>
      </geometry>
      <material name="body_white"/>
    </visual>
    <visual>
      <origin xyz="0 0 -0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.038 0.034 0.030"/>
      </geometry>
      <material name="servo_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.0375" rpy="0 0 0"/>
      <geometry>
        <box size="0.036 0.036 0.075"/>
      </geometry>
    </collision>
  </link>

  <joint name="r_knee" type="revolute">
    <parent link="r_thigh"/>
    <child link="r_shin"/>
    <origin xyz="0 0 -0.075" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.1" upper="2.1" effort="4.0" velocity="4.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <link name="r_shin">
    <inertial>
      <origin xyz="0 0 -0.0375" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.00003"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.0375" rpy="0 0 0"/>
      <geometry>
        <box size="0.034 0.034 0.070"/>
      </geometry>
      <material name="body_white"/>
    </visual>
    <visual>
      <origin xyz="0 0 -0.060" rpy="0 0 0"/>
      <geometry>
        <box size="0.038 0.034 0.028"/>
      </geometry>
      <material name="servo_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.0375" rpy="0 0 0"/>
      <geometry>
        <box size="0.034 0.034 0.075"/>
      </geometry>
    </collision>
  </link>

  <!-- R ankle pitch (servo 10) then ankle roll (servo 9) -->
  <joint name="r_ankle_pitch" type="revolute">
    <parent link="r_shin"/>
    <child link="r_ankle_link"/>
    <origin xyz="0 0 -0.075" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="4.0" velocity="4.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>
  <link name="r_ankle_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.04"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.034 0.034 0.034"/>
      </geometry>
      <material name="servo_black"/>
    </visual>
  </link>

  <joint name="r_ankle_roll" type="revolute">
    <parent link="r_ankle_link"/>
    <child link="r_foot"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.0" upper="1.0" effort="4.0" velocity="4.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>


  <link name="r_foot">
    <inertial>
      <origin xyz="0.015 0 -0.006" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
    <!-- Ankle Bracket -->
    <visual>
      <origin xyz="0 0 -0.003" rpy="0 0 0"/>
      <geometry>
        <box size="0.040 0.038 0.012"/>
      </geometry>
      <material name="servo_black"/>
    </visual>
    <!-- Broad Foot Sole Plate for High Stability -->
    <visual>
      <origin xyz="0.015 0 -0.010" rpy="0 0 0"/>
      <geometry>
        <box size="0.110 0.066 0.008"/>
      </geometry>
      <material name="metal_grey"/>
    </visual>
    <!-- Rubber Sole Pads -->
    <visual>
      <origin xyz="0.015 0 -0.014" rpy="0 0 0"/>
      <geometry>
        <box size="0.108 0.064 0.004"/>
      </geometry>
      <material name="servo_black"/>
    </visual>
    <collision>
      <origin xyz="0.015 0 -0.010" rpy="0 0 0"/>
      <geometry>
        <box size="0.110 0.066 0.012"/>
      </geometry>
    </collision>
  </link>

</robot>
