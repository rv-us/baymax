# Shared settings for the GX10 <-> TonyPi streaming scripts.
# Edit these when you change venues/networks.

# How the GX10 reaches the Pi over SSH: an alias from ~/.ssh/config or user@ip
PI_HOST="tonypi"

# Wi-Fi interface names
PI_IFACE="wlan0"
GX10_IFACE="wlP9s9"

# NetworkManager connection name on the GX10 (see: nmcli -t -f NAME,DEVICE con show --active)
WIFI_CONN="AIHackathon@UCSC"

# Video settings
VIDEO_PORT=5000
VIDEO_DEVICE="/dev/video0"
VIDEO_WIDTH=640
VIDEO_HEIGHT=480
VIDEO_FPS=30
VIDEO_BITRATE_KBPS=1500
KEYFRAME_INTERVAL=15

# JPEG snapshots written on the Pi for the robot API's camera endpoint
# (robot_api/sensors/camera.py reads SNAPSHOT_PATH).
SNAPSHOT_PATH="/dev/shm/baymax_cam.jpg"
SNAPSHOT_FPS=5

# Receiver jitter buffer (ms). Lower = less delay, higher = smoother on bad Wi-Fi.
JITTER_LATENCY_MS=50

# Audio settings (the Pi's microphone -> GX10). The mic is the WonderEcho Pro's
# USB sound card, ALSA card "Device", which the robot API's speaker also uses.
AUDIO_ENABLED=1
AUDIO_PORT=5002
PI_AUDIO_CARD="Device"
# Shared capture device on the Pi (dsnoop), created by setup_pi_audio.sh so the
# stream and the robot API's mic_level can record at the same time.
PI_MIC_PCM="mic_shared"
AUDIO_RATE=16000          # what the GX10 receives: 16 kHz mono, what Whisper wants
AUDIO_BITRATE=24000       # Opus bits/s; plenty for speech
AUDIO_FRAME_MS=20         # Opus frame length
AUDIO_JITTER_MS=60        # receiver jitter buffer for audio
